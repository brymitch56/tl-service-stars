# Copy to .env (chmod 600). .env is gitignored — never commit it.

# --- the app ---------------------------------------------------------------
PORT=3200
HOST=127.0.0.1                 # a tunnel/proxy fronts this; do not bind 0.0.0.0
TZ=America/New_York            # the troop's timezone; "today" depends on it
TROOP_ID=XX-0000
TROOP_NAME=Trail Life Troop
PUBLIC_URL=https://stars.example.org

# --- who may sign in -------------------------------------------------------
# The recovery hatch: these addresses are admins whatever the database says,
# and the UI cannot demote or disable them. With an empty database, the first
# one gets an account and a one-time password printed to the log at startup.
ADMIN_EMAILS=admin@example.org
SESSION_DAYS=14
SECURE_COOKIES=true            # false ONLY for plain-HTTP local development
TRUST_PROXY=true

# --- Trail Life Connect ----------------------------------------------------
# Credentials are normally saved in the app (Settings -> Trail Life Connect),
# encrypted at rest. These are the fallback for a headless first run.
TLC_ENABLED=true
# TLC_BASE=https://www.traillifeconnect.com
# TLC_EMAIL=leader@example.org
# TLC_PASSWORD=fake-password-never-real
# TLC_THROTTLE_MS=300          # minimum gap between requests to the portal
# TLC_MAX_PAGES=20             # ledger paging guard (the grid caps at 100 rows)
# Escape hatches for the second-factor form, which is normally found by shape:
# TLC_MFA_FIELD=               # pin the code input's name
# TLC_MFA_PATH=                # pin where to post it
# TLC_PROBE_PATH=              # cheap page used to test a stored session

# --- scheduling ------------------------------------------------------------
# The nightly job only READS. Recording stars on the portal is never
# scheduled — an admin presses "Push now" and watches it.
SCHEDULE_SYNC=nightly          # nightly | off
# DISABLE_SCHEDULER=true       # dev only; never on the Pi

# CRED_KEY is generated into .env the first time portal credentials or a
# portal session are stored. Never set it by hand, never commit it. Losing it
# means reconnecting the portal — nothing else.
